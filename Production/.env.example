# ==============================================================================
# VESPER Desktop Application - Environment Configuration (.env.example)
# ==============================================================================

# 1. CLOUD LAUNCHPAD & WEB API CONNECTION
# ------------------------------------------------------------------------------
# Points your desktop client to the cloud Launchpad / Admin server.
# For local development: http://localhost:8080
# For cloud production: https://your-launchpad-domain.vercel.app or https://api.vesper.ai
VITE_VESPER_API_URL=http://localhost:8080

# 2. FREE-TIER AI PROVIDERS (free-for.dev Zero-Cost LLMs)
# ------------------------------------------------------------------------------
# Groq Cloud API Key for ultra-fast Whisper STT & Llama 3.3 70B polishing (Free: console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI Studio Gemini API Key for Gemini 1.5 Flash (Free: aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. SPEECH-TO-TEXT MODEL CONFIGURATION
# ------------------------------------------------------------------------------
# Options: whisper-large-v3, whisper-large-v3-turbo, distil-whisper
WHISPER_MODEL=whisper-large-v3

# Speech Language (auto or 2-letter ISO code: en, hi, fr, es, de, ja, zh, etc.)
WHISPER_LANGUAGE=auto

# Dictation Mode: 'direct' (verbatim text) or 'smart_assistant' (prompt templates)
DICTATION_MODE=direct

# 4. HARDWARE PUSH-TO-TALK KEY
# ------------------------------------------------------------------------------
# Options: RIGHT ALT, FN, F8, RIGHT CTRL, LEFT ALT, CAPS LOCK
HOLD_KEY=RIGHT ALT

# AI Polishing (true to remove filler words like 'um' / 'uh' and apply natural punctuation)
AI_POLISHING=true
