# ==========================================================
# QEVRA Desktop - Environment Template (.env.example)
# ==========================================================

# Groq Cloud API Key for ultra-fast Whisper STT & Llama 3.3 polishing
# Get your free key at: https://console.groq.com/keys (No credit card required)
GROQ_API_KEY=gsk_your_groq_api_key_here
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Speech-to-Text Model configuration
# Options: whisper-large-v3, whisper-large-v3-turbo
WHISPER_MODEL=whisper-large-v3

# Speech Language (auto or 2-letter ISO code: en, hi, fr, es, de, ja, zh, etc.)
WHISPER_LANGUAGE=auto

# Dictation Mode: 'direct' (verbatim text) or 'smart_assistant' (prompt templates)
DICTATION_MODE=direct

# Hardware Push-to-Talk Key (RIGHT ALT, FN, F8, RIGHT CTRL, LEFT ALT, CAPS LOCK)
HOLD_KEY=RIGHT ALT

# AI Polishing (true to remove filler words like 'um' / 'uh' and apply natural punctuation)
AI_POLISHING=true
